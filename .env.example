# Copy to .env and fill in. Never commit .env.

# --- Claude (triage agent) ---------------------------------------------------
ANTHROPIC_API_KEY=
# Defaults shown; effort is low | medium | high | xhigh | max
TRIAGE_MODEL=claude-opus-5-5
TRIAGE_EFFORT=medium
# "default" re-runs a request declined by a safety classifier on Anthropic's recommended
# fallback model; set to "off" for models or platforms without server-side fallbacks.
TRIAGE_FALLBACKS=default
# Verdict store used for dedupe in --watch mode and by the HTML report
TRIAGE_DB=data/soc.db
# Stop calling the API once today's estimated spend (USD, list prices) reaches this. 0 or empty = no cap.
TRIAGE_DAILY_BUDGET_USD=5
# Cowrie's downloads directory; captured payloads get static analysis in the enrichment
# COWRIE_DOWNLOADS_DIR=/cowrie/cowrie-git/var/lib/cowrie/downloads

# --- Azure: log shipping (printed by siem/infra/deploy.ps1) -------------------
AZURE_DCE_ENDPOINT=
AZURE_DCR_IMMUTABLE_ID=
AZURE_DCR_STREAM=Custom-Cowrie_CL

# --- Azure: querying Sentinel (workspace GUID, a.k.a. customer ID) -------------
AZURE_LOG_ANALYTICS_WORKSPACE_ID=
# Full resource id, for incident write-back and the IOC watchlist (also printed by deploy.ps1)
AZURE_WORKSPACE_RESOURCE_ID=

# Service-principal auth, only if you are not using `az login` or a managed identity:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# --- Shipper ---------------------------------------------------------------------
COWRIE_LOG_PATH=/cowrie/cowrie-git/var/log/cowrie/cowrie.json
SHIPPER_STATE_FILE=data/state/ship_logs.json

# --- Threat intel (optional) --------------------------------------------------------
# Leave a key unset to skip that source. GreyNoise Community works keyless:
# set GREYNOISE_API_KEY to an empty value to enable it without a key.
ABUSEIPDB_API_KEY=
# GREYNOISE_API_KEY=
ENRICHMENT_CACHE=data/cache/intel.json
# Payload hash reputation (optional)
# MALWAREBAZAAR_API_KEY=
# VT_API_KEY=
