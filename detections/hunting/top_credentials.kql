// Most-tried credential pairs and how often each one worked
Cowrie_CL
| where eventid in ("cowrie.login.failed", "cowrie.login.success")
| summarize Attempts = count(),
            Successes = countif(eventid == "cowrie.login.success"),
            SourceIPs = dcount(src_ip)
    by username, password
| top 25 by Attempts
