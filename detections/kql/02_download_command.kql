// name: Payload download command
// severity: High
// tactics: CommandAndControl
// techniques: T1105
// frequency: PT10M
// period: PT10M
// description: A session ran a download utility (wget, curl, tftp, ftpget) after logging in.
Cowrie_CL
| where eventid == "cowrie.command.input"
| where input has_any ("wget", "curl", "tftp", "ftpget")
| summarize Commands = make_list(input, 25),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
    by src_ip, session
