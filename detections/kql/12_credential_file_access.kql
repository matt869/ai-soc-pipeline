// name: Credential file access
// severity: High
// tactics: CredentialAccess
// techniques: T1003.008
// frequency: PT10M
// period: PT10M
// description: A session read a hashed-password file (/etc/shadow, /etc/gshadow) to dump credentials for cracking or reuse.
Cowrie_CL
| where eventid == "cowrie.command.input"
| where input contains "/etc/shadow" or input contains "/etc/gshadow"
| summarize Commands = make_list(input, 25),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
    by src_ip, session
