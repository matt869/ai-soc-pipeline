// name: Account password change
// severity: High
// tactics: Persistence
// techniques: T1098
// frequency: PT10M
// period: PT10M
// description: A session changed an account password (chpasswd, usermod -p) to lock out the owner or keep access.
Cowrie_CL
| where eventid == "cowrie.command.input"
| where input contains "chpasswd" or input contains "usermod -p"
| summarize Commands = make_list(input, 25),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
    by src_ip, session
